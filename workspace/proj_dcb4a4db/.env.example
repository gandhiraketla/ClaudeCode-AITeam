# Travel Itinerary Agent — Environment Variables
# Copy this file to .env and fill in your actual API keys

# Anthropic API Key — used for LLM inference (intent extraction, clarification, itinerary composition)
# Get it: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SerpApi API Key — used for Google Flights and Google Hotels real-time data
# Get it: https://serpapi.com
SERPAPI_API_KEY=your_serpapi_api_key_here
